    given-names: Maximilian
    email: maximilian.zinke@gmail.com
    # TODO(ORCID): add "orcid: https://orcid.org/XXXX-XXXX-XXXX-XXXX"
version: 0.4.0
date-released: "2026-08-30"
license: MIT
repository-code: "https://github.com/maxzinke/caustic-nmr"
url: "https://huggingface.co/spaces/SiXa18/caustic"
keywords:
  - NMR
  - chemical shift prediction
  - protein structure
  - graph neural network
  - PaiNN
  - AlphaFold
  - uncertainty calibration
